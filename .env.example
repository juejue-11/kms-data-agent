# npm run start:pcb / npm run cli:pcb；相对路径均相对仓库根目录。
PORT=9100
PCB_HOST=127.0.0.1
# 数据、领域工作目录与 Pi 配置分开；数据和凭据目录不能放入 web-ui。
PCB_DATA_DIR=.pcb-data
PCB_WORKSPACE_DIR=.pcb-data/workspace
PI_CODING_AGENT_DIR=.pi-agent
PCB_CONFIG_VERSION=1
# 闲置回收仅释放实例、不删历史；请求总时限与单次检索超时分别限制。
PCB_SESSION_IDLE_TTL_MS=600000
PCB_MAX_ACTIVE_REQUESTS=4
PCB_REQUEST_TIMEOUT_MS=180000
PCB_MAX_TOOL_CALLS=8
PCB_RETRIEVAL_TIMEOUT_MS=15000
PCB_KB_MIN_SIMILARITY=0.35
PCB_KB_TOP_K=2
# 联网总开关、KB 故障后联网、本地降级和跨会话记忆均需显式开启。
PCB_ALLOW_WEB_SEARCH=false
PCB_ALLOW_WEB_ON_KB_ERROR=false
PCB_ALLOW_LOCAL_FALLBACK=false
PCB_MEMORY_ENABLED=false
# KB 凭据仅供服务端使用；多个数据集 ID 以英文逗号分隔。
RAGFLOW_BASE_URL=http://localhost:80
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
# LOCAL_KB_DIR=受控的本地txt资料绝对路径
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
# CLI 连接同一服务；状态文件只保存服务端签发的访客凭据。
PCB_SERVER_URL=http://127.0.0.1:9100
# PCB_CLI_STATE_FILE=
# 模型、思考级别、压缩及重试放 .pi-agent/settings.json。
# 凭据放 .pi-agent/auth.json，自定义模型放 .pi-agent/models.json。
